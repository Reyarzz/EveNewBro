# Copy this file to ".env" and fill in your EVE application's Client ID.
# Create the app (free) at https://developers.eveonline.com/ :
#   - Connection Type: "Authentication & API Access"
#   - Callback URL:     http://localhost:3838/callback
#   - Scopes: copy all scopes from the Me tab (or README SSO section)
# PKCE is used, so NO client secret is needed.

EVE_CLIENT_ID=your-client-id-here

# Optional: community fits from EVE Workbench (auto-updates daily).
# Register a free app at https://www.eveworkbench.com/my-account/developer
# (Public / Limited Access is fine) to get a Client ID + API Key.
# You can also enter these in-app on the Fits tab instead of here.
EWB_CLIENT_ID=
EWB_API_KEY=
